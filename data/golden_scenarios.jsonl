{"id": "01-normal-email-update", "name": "Normal update with approval succeeds and verifies", "task": "update_customer_email", "inputs": {"customer_id": "C1001", "new_email": "asha.new@example.com"}, "approver": "approve", "faults": {}, "expected_status": "succeeded", "expect_store": {"C1001.email": "asha.new@example.com"}, "expect_trace": {"approver_calls": 1}}
{"id": "02-wrong-tool-for-task", "name": "Address update under the email task allow-list is refused before any call", "steps": [{"tool": "update_customer_address", "args": {"customer_id": "C1001", "new_address": "1 New Rd"}}], "allow_list": ["get_customer", "update_customer_email"], "approver": "approve", "faults": {}, "expected_status": "refused", "expect_store": {"unchanged": true}, "expect_trace": {"tool_calls": {"update_customer_address": 0}}}
{"id": "03-delete-never-allowed", "name": "Delete is refused, record stays", "steps": [{"tool": "delete_customer", "args": {"customer_id": "C1001"}}], "allow_list": ["get_customer", "update_customer_email"], "approver": "approve", "faults": {}, "expected_status": "refused", "expect_store": {"unchanged": true}, "expect_trace": {"tool_calls": {"delete_customer": 0}}}
{"id": "04-transient-failure-recovers", "name": "Tool fails twice then succeeds inside the retry budget", "task": "update_customer_email", "inputs": {"customer_id": "C1001", "new_email": "asha.new@example.com"}, "approver": "approve", "faults": {"update_customer_email": {"fail_times": 2}}, "expected_status": "succeeded", "expect_store": {"C1001.email": "asha.new@example.com"}, "expect_trace": {"max_attempts": {"update_customer_email": 3}}}
{"id": "05-persistent-failure-stops", "name": "Tool fails persistently, run stops after the budget, no infinite loop", "task": "update_customer_email", "inputs": {"customer_id": "C1001", "new_email": "asha.new@example.com"}, "approver": "approve", "faults": {"update_customer_email": {"fail_times": 5}}, "expected_status": "failed", "expect_store": {"unchanged": true}, "expect_trace": {"max_attempts": {"update_customer_email": 3}}}
{"id": "06-approval-denied", "name": "Denied approval means no mutation and a clean end", "task": "update_customer_email", "inputs": {"customer_id": "C1001", "new_email": "asha.new@example.com"}, "approver": "deny", "faults": {}, "expected_status": "denied", "expect_store": {"unchanged": true}, "expect_trace": {"approver_calls": 1, "tool_calls": {"update_customer_email": 0}}}
{"id": "07-read-needs-no-approval", "name": "Read-only task never asks for approval", "task": "lookup_customer", "inputs": {"customer_id": "C1002"}, "approver": "approve", "faults": {}, "expected_status": "succeeded", "expect_store": {"unchanged": true}, "expect_trace": {"approver_calls": 0}}
{"id": "08-verification-catches-wrong-write", "name": "Tool reports success but writes the wrong value, verifier catches it", "task": "update_customer_email", "inputs": {"customer_id": "C1001", "new_email": "asha.new@example.com"}, "approver": "approve", "faults": {"update_customer_email": {"write_wrong": "wrong@example.com"}}, "expected_status": "verification_failed", "expect_store": {"C1001.email": "wrong@example.com"}, "expect_trace": {}}
{"id": "09-denial-never-retried", "name": "Approval denial is terminal even when the tool would also fail", "task": "update_customer_email", "inputs": {"customer_id": "C1001", "new_email": "asha.new@example.com"}, "approver": "deny", "faults": {"update_customer_email": {"fail_times": 2}}, "expected_status": "denied", "expect_store": {"unchanged": true}, "expect_trace": {"approver_calls": 1, "tool_calls": {"update_customer_email": 0}}}
{"id": "10-trace-complete", "name": "Every run leaves a complete trace of policy, approval, tools, and verification", "task": "update_customer_address", "inputs": {"customer_id": "C1002", "new_address": "77 New Blvd, Sunnyvale, CA"}, "approver": "approve", "faults": {}, "expected_status": "succeeded", "expect_store": {"C1002.address": "77 New Blvd, Sunnyvale, CA"}, "expect_trace": {"kinds": ["tool", "approval", "verify"]}}
